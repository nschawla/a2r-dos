// A2R Delivery OS — Phase 3 SaaS foundation schema.
//
// This models the exact domain captured by the Phase 1/2 static prototype
// (a2r/index.html`state` object), lifted into a multi-tenant Postgres schema:
//   Organization -> Practices / Roles (rate card) / Resources / Policy / Controls
//   Organization -> Projects -> Scope, Effort Matrix, Audit, RAID, Financials, Schedule
//
// Every org-scoped model carries organizationId directly (not just via project)
// so tenant isolation can be enforced at the query layer without extra joins.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime queries. On serverless (Vercel) this MUST be a connection
  // pooler URL — Supabase's direct host (db.<ref>.supabase.co) is
  // IPv6-only and Vercel functions have no IPv6 egress, so a direct URL
  // fails every query there. See .env.example.
  url       = env("DATABASE_URL")
  // Schema pushes / migrations (`prisma db push`, `prisma migrate`) — a
  // real session, not a transaction-mode pooler. Falls back to `url`
  // when unset (fine for local dev where both point at the same host).
  directUrl = env("DIRECT_URL")
}

// =========================================================
// AUTH / TENANCY
// =========================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // set for credentials-based accounts; null for OAuth-only users

  // True when the account's current password was set by someone OTHER than
  // the user — a seeded demo account left as-is, or (the real case) an
  // A2R-operator-provisioned tenant admin who received a temp password.
  // src/middleware.ts forces such a user to /change-password on their next
  // sign-in until they set their own; changePasswordAction clears it. A
  // self-registered user (who chose their own password) is never flagged.
  // P0 #3: enforcement is not middleware-only — every server-action /
  // route-handler auth path rejects a `mustChangePassword` session with
  // PASSWORD_CHANGE_REQUIRED (see src/lib/auth/password-rotation.ts).
  mustChangePassword Boolean @default(false)

  // Set every time the password changes — an audit timestamp, and a
  // belt-and-suspenders revocation signal (a token whose `iat` predates it
  // is REVOKED).
  passwordChangedAt DateTime?

  // P1 — the session state machine's token-version / epoch. Every session
  // token is minted carrying the value it saw here; `changePasswordAction`
  // (and any future forced-logout event) does `{ increment: 1 }`, so every
  // token minted before that instant fails the DB-backed check in the
  // NextAuth jwt callback and is REVOKED. See docs/SESSION_STATE_MACHINE.md.
  sessionVersion Int @default(0)

  createdAt DateTime @updatedAt @default(now())
  updatedAt DateTime @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  activity    ActivityLogEntry[]
  // A user can be the login for at most one Resource (roster entry) per
  // org — see Resource.userId. A consultant working across client
  // instances can still be a different Resource in each org.
  resourceLinks Resource[]
  // WP6 — every AuditLog row this user was the actor for.
  auditLogs   AuditLog[]
  // WP7 — every batch this user has staged via the Self-Service Ingestion
  // Portal.
  dataImportBatches DataImportBatch[]
  // Every custom KPI definition this user authored.
  customKpis        CustomKpi[]
  // A2R Operator Control Plane — every staff-access entitlement ever
  // granted to this account (see StaffGrant). Staff status = at least one
  // row here with revokedAt = null.
  staffGrants       StaffGrant[]
  // P1 JIT elevation — every temporary privilege elevation this operator
  // has requested (see StaffElevation). A standing StaffGrant is only
  // eligibility; a mutating /ops action needs a live row here.
  staffElevations   StaffElevation[]

  @@map("users")
}

// A2R Operator Control Plane — an EXPLICIT, auditable grant of internal
// /ops console access (cross-tenant provisioning, telemetry, tenant
// lifecycle) to one specific User.
//
// This replaces the former `User.isA2rStaff` boolean + the
// `@a2rventures.com` email-domain wildcard (P0 #2, 2026-09). There is no
// longer any implicit path to staff access: a compromised corporate inbox
// grants nothing. An account is staff iff it holds a row here with
// `revokedAt` still null. The NextAuth jwt callback resolves that into
// `token.isA2rStaff` each request; src/lib/ops-auth.ts re-checks this table
// directly on every /ops render / action.
model StaffGrant {
  id              String    @id @default(cuid())
  userId          String
  // The operator who granted it. Null only for the seed / initial
  // bootstrap grant (no operator exists yet to attribute it to).
  grantedByUserId String?
  reason          String
  createdAt       DateTime  @default(now())
  // Set to soft-revoke. A revoked grant never confers access again; a new
  // grant row is created to re-grant, so the full history is preserved.
  revokedAt       DateTime?
  revokedByUserId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("staff_grants")
}

// A2R Operator Control Plane — Just-In-Time privilege elevation (P1, 2026-09).
//
// A live StaffGrant is only *eligibility* to reach the /ops read views. Every
// state-changing /ops operation (provision / suspend / impersonate / export /
// purge / API keys / identity federation / grant+revoke staff) requires a
// live row here: not ended, not past expiresAt, and whose userId matches the
// authenticated operator session. Requested with a reason, auto-expires after
// a strict TTL (default 30 min, hard cap OPS_ELEVATION_MAX_MINUTES, ≤ 60).
// These rows ARE the audit trail — like StaffGrant, there is no separate
// ledger (elevation is a platform event, not tenant-scoped).
// Service: src/lib/ops/staff-elevation.ts. Guard: src/lib/ops-auth.ts.
model StaffElevation {
  id              String    @id @default(cuid())
  userId          String
  // P0-5 — SHA-256 of the opaque bearer token. The plaintext secret is
  // dropped into the httpOnly `a2r_ops_elevation` cookie and never stored;
  // `resolveActiveElevation` looks the row up by `hashToken(cookieValue)`.
  // (mirrors the Impersonation Gateway's a2r_impersonation, and ApiKey.hashedKey.)
  tokenHash       String    @unique
  reason          String
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  // Set on an explicit early "Drop elevation" or a future expiry sweep.
  endedAt         DateTime?
  endedReason     String? // 'operator' | 'superseded' | 'expired-sweep'
  requestedFromIp String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("staff_elevations")
}

// Standard Auth.js (NextAuth) Prisma adapter models — kept so OAuth providers
// can be added later without a schema migration; Credentials login does not
// use these tables directly (JWT session strategy).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// WP4 — the real, server-enforced enterprise RBAC tier (Module-level
// portfolio scoping and edit authority). Deliberately a *separate* axis
// from MembershipRole above, not a replacement for it: MembershipRole is
// the tenant-console tier (who can manage billing/org membership — see
// LOCK_ROLES in src/server/actions/projects.ts, which still checks
// MembershipRole for baseline lock/unlock), while DeliveryAccessRole is
// the delivery-portfolio tier src/lib/auth/rbac.ts's permission matrix
// operates on. Nullable so existing memberships created before this field
// existed keep working — src/lib/auth/rbac.ts#resolveDeliveryRole()
// derives a sensible default from MembershipRole when this is unset,
// rather than requiring a backfill migration.
//
// This is unrelated to (and does not replace) the WP3 "Persona" switcher
// in src/components/layout/dashboard-ui-context.tsx, which remains a
// purely cosmetic, client-only, localStorage-persisted UI preview and
// still never gates anything server-side.
enum DeliveryAccessRole {
  ADMIN
  VP_EXECUTIVE
  PRACTICE_DIRECTOR
  DELIVERY_MANAGER
  PROJECT_MANAGER
}

// How a Membership's role assignment was last set. SSO_JIT means the role
// is owned by the tenant's identity federation (security-group mapping) and
// will be re-synced on the member's next federated login — see
// src/lib/identity/jit.ts.
enum ProvisioningSource {
  MANUAL
  SSO_JIT
}

// A user's membership in a tenant org. A user can belong to more than one
// org (e.g. a consultant working across client instances).
model Membership {
  id             String              @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole      @default(MEMBER)
  deliveryRole   DeliveryAccessRole?
  createdAt      DateTime            @default(now())

  // Enterprise Identity — provisioning provenance.
  provisionedVia ProvisioningSource @default(MANUAL)
  lastJitSyncAt  DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

// A2R Operator Control Plane — lifecycle state of a client tenant, managed
// from /ops/tenants. SUSPENDED tenants still exist (data retained) but their
// members are locked out of the client workspace until reactivated; A2R
// staff are never locked out.
enum OrgStatus {
  ACTIVE
  // Members locked out entirely; data retained.
  SUSPENDED
  // Read-only wind-down window (e.g. pre-offboarding): members can view
  // but not write; A2R staff unaffected.
  GRACE_PERIOD
}

// A2R Operator Control Plane — commercial tier a tenant is contracted on.
// Display/segmentation only today (shown in /ops/tenants and telemetry); no
// feature gating hangs off it yet.
enum ContractTier {
  TRIAL
  STANDARD
  ENTERPRISE
}

// The SaaS tenant. Everything below hangs off an Organization.
model Organization {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  status       OrgStatus    @default(ACTIVE)
  contractTier ContractTier @default(STANDARD)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Data Sovereignty & Offboarding — soft-delete marker set by the Purge
  // Protocol (rows are retained but the tenant is excluded from all
  // operator + client surfaces); and the last successful data-export time.
  purgedAt        DateTime?
  dataExportedAt  DateTime?

  memberships      Membership[]
  policy           OrgPolicy?
  governanceConfig GovernanceConfig?
  identityProvider IdentityProvider?
  controlLabels    ControlLabel[]
  practices      Practice[]
  deliveryRoles  DeliveryRole[]
  resources      Resource[]
  projects       Project[]
  activity       ActivityLogEntry[]
  auditLogs      AuditLog[]
  weeklyAssignmentSlots WeeklyAssignmentSlot[]
  holidays               OrganizationHoliday[]
  roleUtilizationPolicies RoleUtilizationPolicy[]
  auditLedger            ImmutableAuditLedger[]
  impersonationGrants    ImpersonationGrant[]
  apiKeys                ApiKey[]
  timesheetEntries       TimesheetEntry[]
  dataImportBatches      DataImportBatch[]
  customKpis             CustomKpi[]

  // P1 — composite tenant keys: project/batch-scoped models now carry their
  // own organizationId FK (migration 00000000000012).
  projectContributors    ProjectContributor[]
  scopeItems             ScopeItem[]
  effortCells            EffortCell[]
  auditEntries           AuditEntry[]
  raidEntries            RaidEntry[]
  financialActuals       FinancialActual[]
  schedulePhases         SchedulePhase[]
  steerCoDecisions       SteerCoDecision[]
  dataImportRows         DataImportRow[]

  @@map("organizations")
}

// Super-Admin Tenant & Data Sovereignty — the Impersonation Gateway.
// An A2R staff account can mint a short-lived, read-only grant to enter a
// specific tenant's workspace for troubleshooting. src/lib/session.ts
// honours a live grant (token carried in the `a2r_impersonation` cookie);
// every grant creation writes an ADMIN_IMPERSONATION_ACCESS entry to that
// tenant's Immutable Audit Ledger.
model ImpersonationGrant {
  id             String    @id @default(cuid())
  // P0-5 — SHA-256 of the opaque bearer token carried in the httpOnly
  // `a2r_impersonation` cookie; the plaintext is never stored.
  tokenHash      String    @unique
  actorId        String // the A2R staff User id
  organizationId String
  reason         String
  readOnly       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  endedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("impersonation_grants")
}

// =========================================================
// MODULE 0 — ADMIN & ORG SETUP
// =========================================================

enum Methodology {
  WATERFALL
  AGILE
  HYBRID
}

// Governance tolerances + methodology preset. Mirrors state.policy
// (minus .controls, which is normalized out into ControlLabel rows).
model OrgPolicy {
  id             String      @id @default(cuid())
  organizationId String      @unique
  slipWarnDays   Int         @default(5)
  slipCritDays   Int         @default(15)
  marginCritPct  Float       @default(5)
  methodology    Methodology @default(WATERFALL)
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("org_policies")
}

// Enterprise Governance Architecture — Step 1: the Hybrid Configuration
// Model. Layer 1 is a pre-built compliance template (pre-tested defaults);
// Layer 2 is the tenant's own overrides on top — which modules are visible
// in navigation, and whether margins / EAC are scrubbed for delivery roles
// below VP. `template` becomes CUSTOM once the stored settings no longer
// match any template exactly (see src/lib/governance/config.ts).
enum GovernanceTemplate {
  STANDARD
  STRICT_FINANCIAL
  AGILE_DELIVERY
  BOARD_ONLY
  CUSTOM
}

model GovernanceConfig {
  id             String             @id @default(cuid())
  organizationId String             @unique
  template       GovernanceTemplate @default(STANDARD)
  // Module keys (src/lib/governance/config.ts GOVERNABLE_MODULES) hidden
  // from this tenant's navigation. Core modules are never hidden even if
  // they appear here.
  hiddenModules  String[]           @default([])
  // Layer-2 financial masking: when true, blended margin, EAC and financial
  // variance are masked for every delivery role below VP_EXECUTIVE (i.e.
  // Practice Director / Delivery Manager / Project Manager), on top of the
  // standard role-based masking in src/lib/security/masking.ts.
  maskFinancialsForDelivery Boolean  @default(false)
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("governance_configs")
}

// =========================================================
// ENTERPRISE IDENTITY & GOVERNANCE — Step 2: SSO / identity federation
// =========================================================

enum IdpProtocol {
  SAML
  OIDC
}

// The IdP vendor this tenant federates with. Drives the metadata/discovery
// hints and setup guidance in the Admin federation panel; GENERIC covers
// any other conformant SAML 2.0 / OIDC provider.
enum IdpVendor {
  AZURE_AD // Microsoft Entra ID
  OKTA
  GOOGLE_WORKSPACE
  GENERIC
}

// One tenant's Enterprise SSO configuration. At most one IdP per org
// (org-level federation, not per-user). Secrets are never stored in the
// clear — the OIDC client secret is AES-256-GCM encrypted
// (src/lib/identity/crypto.ts) and only its fingerprint is shown in the UI.
model IdentityProvider {
  id             String      @id @default(cuid())
  organizationId String      @unique
  protocol       IdpProtocol
  vendor         IdpVendor   @default(GENERIC)
  displayName    String

  // Config saved but not live until an admin has verified the metadata and
  // switched it on. `enforced` blocks password login for `emailDomains`.
  enabled  Boolean  @default(false)
  enforced Boolean  @default(false)
  // Lowercase bare domains this IdP is authoritative for, e.g. "contoso.com".
  emailDomains String[] @default([])

  // Just-In-Time provisioning — create/refresh a Membership on first
  // federated login, with the role resolved from the security-group
  // mappings below (falling back to these defaults).
  jitEnabled            Boolean            @default(true)
  defaultDeliveryRole   DeliveryAccessRole @default(PROJECT_MANAGER)
  defaultMembershipRole MembershipRole     @default(MEMBER)

  // ── SAML 2.0 ──
  samlEntityId    String?
  samlSsoUrl      String?
  samlCertificate String? @db.Text // IdP x509 signing certificate (PEM/base64 body)

  // ── OIDC ──
  oidcIssuer                 String?
  oidcClientId               String?
  oidcClientSecretCiphertext String? @db.Text
  oidcDiscoveryUrl           String?
  oidcAuthEndpoint           String? // cached from the discovery doc at last verify
  oidcTokenEndpoint          String?
  oidcJwksUri                String?

  // Metadata verification trail (surfaced in the Admin panel).
  lastVerifiedAt      DateTime?
  metadataFingerprint String? // sha256 of the signing cert / discovery issuer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupMappings SsoGroupMapping[]
  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("identity_providers")
}

// Security-group → role mapping for federated logins. On JIT provisioning,
// the login's group / role claim values are matched (case-insensitively)
// against `claimValue`; the lowest `priority` wins. No match → the IdP's
// default role.
model SsoGroupMapping {
  id                 String             @id @default(cuid())
  identityProviderId String
  organizationId     String // denormalized for tenant-scoped queries
  claimValue         String // IdP group name or object id, e.g. "Delivery-Admins"
  deliveryRole       DeliveryAccessRole
  membershipRole     MembershipRole     @default(MEMBER)
  practiceId         String? // optional: also set the JIT resource's practice
  priority           Int                @default(100)
  createdAt          DateTime           @default(now())

  identityProvider IdentityProvider @relation(fields: [identityProviderId], references: [id], onDelete: Cascade)

  @@unique([identityProviderId, claimValue])
  @@index([organizationId])
  @@map("sso_group_mappings")
}

// Org-level display-label override for one of the 10 Minimum Controls.
// The control catalog itself (id, why, evidence, per-methodology default
// labels) is seed/reference data (see prisma/seed.ts), not tenant data —
// this table only stores the org's chosen rename, keyed by controlKey.
model ControlLabel {
  id             String @id @default(cuid())
  organizationId String
  controlKey     String // e.g. "CTRL_01".."CTRL_10"
  label          String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, controlKey])
  @@map("control_labels")
}

model Practice {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveryRoles DeliveryRole[]
  resources    Resource[]
  // WP4: a project's home practice, for PRACTICE_DIRECTOR portfolio
  // scoping ("projects in their practice domain") independent of who's
  // formally assigned as PD on any given project — see Project.practiceId.
  projects     Project[]

  @@index([organizationId])
  @@map("practices")
}

// WP6 — Employee (FTE) vs. Contractor / Vendor classification. Lives on
// the rate-card role, not on the named Resource: Sizing (EffortCell) and
// Financials (FinancialActual) are both role-keyed, not resource-keyed —
// neither table has a resourceId column, and adding one would be a much
// bigger schema change than this WP's "expose the distinction in Sizing
// and Financials" ask actually requires. A role can only be all-FTE or
// all-Contractor at a time (matches the spec's own framing: both surfaces
// this needs to show up in are role-keyed screens); a named person's
// individual employment status, if ever needed independent of which rate
// card role they bill against, is future scope.
enum ResourceEmploymentType {
  FTE
  CONTRACTOR
}

// Rate-card role. Named DeliveryRole (not "Role") to avoid clashing with
// auth MembershipRole. These rows become the live row-set of every
// project's Phase-Effort Matrix.
model DeliveryRole {
  id             String                 @id @default(cuid())
  organizationId String
  name           String
  billRate       Float
  costRate       Float
  practiceId     String?
  // WP6 — see ResourceEmploymentType above.
  employmentType ResourceEmploymentType @default(FTE)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  practice     Practice?    @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  resources    Resource[]
  effortCells  EffortCell[]
  financials   FinancialActual[]

  @@index([organizationId])
  @@map("delivery_roles")
}

model Resource {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  email          String?
  roleId         String?
  practiceId     String?

  // WP4 — RBAC scoping. Both nullable: a Resource is a roster/rate-card
  // entry first and may exist with no linked login (e.g. a named
  // subcontractor never given app access) and no manager on file yet.
  // userId links this roster entry to the User who logs in as this
  // person — src/lib/session.ts resolves the signed-in user's resourceId
  // this way. managerId is the reporting line a DELIVERY_MANAGER's scoped
  // query walks to find "my direct-report PMs" (see
  // src/lib/db/scoped-portfolio.ts).
  userId    String?
  managerId String?

  // ---- Capacity & Concurrency schema foundation ----
  // Domain-led practice / department the resource sits in — one of the
  // modern taxonomy codes ("TRANS-Delivery", "FIN-Advisory",
  // "TECH-Transformation", "OPS-Strategy", "DATA-Analytics"). Free-text so
  // a tenant can extend it. Distinct from the relational
  // `practice`/`practiceId` above, which is the RBAC-scoping Practice row —
  // this is the capacity-planning bucket.
  psPractice    String  @default("TRANS-Delivery")
  // Free-text manager name, distinct from the relational `manager`
  // reporting line above (which a DELIVERY_MANAGER's scoped query walks).
  managerName   String?
  fte           Float   @default(1.0)
  // Per-person target utilisation override — the capacity engine prefers
  // rolePolicy.targetUtilPct when a policy is linked, and falls back to this.
  targetUtilPct Float   @default(0.70)
  isPS          Boolean @default(true)
  projectCount  Int     @default(0) // concurrency tracker
  // Capacity Cockpit — role utilisation policy + roster tenure. startDate/
  // endDate prorate the Available-Hours denominator (individual PTO does not).
  rolePolicyId  String?
  startDate     DateTime  @default(now())
  endDate       DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         DeliveryRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  practice     Practice?     @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  manager      Resource?     @relation("ResourceManager", fields: [managerId], references: [id], onDelete: SetNull)
  rolePolicy   RoleUtilizationPolicy? @relation(fields: [rolePolicyId], references: [id], onDelete: SetNull)

  directReports Resource[] @relation("ResourceManager")
  projectsAsPD  Project[]   @relation("ProjectPD")
  projectsAsDM  Project[]   @relation("ProjectDM")
  projectsAsPM  Project[]   @relation("ProjectPM")
  raidEntries   RaidEntry[]
  contributions ProjectContributor[]
  // WP7 — SteerCo decisions this resource is the named owner of.
  steerCoDecisions SteerCoDecision[]
  // Capacity foundation — weekly forecast/actual assignment slots.
  weeklySlots      WeeklyAssignmentSlot[]
  timesheetEntries TimesheetEntry[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([managerId])
  @@map("resources")
}

// ---- Capacity & Concurrency schema foundation ----
// One resource's forecast vs. actual hours on one project for one week.
// The time-series backing the Financial Realization burn curve (RTM C4)
// and the future capacity/utilisation views.
model WeeklyAssignmentSlot {
  id             String   @id @default(cuid())
  organizationId String
  resourceId     String
  projectId      String
  weekDate       DateTime // the Monday of the ISO week
  forecastedHours Float   @default(0)
  actualHours     Float   @default(0)
  role           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resource     Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade)

  @@unique([resourceId, projectId, weekDate])
  @@index([organizationId])
  @@index([projectId, weekDate])
  @@index([resourceId, weekDate])
  @@map("weekly_assignment_slots")
}

// ---- Secure Data Ingestion API Bridge ----
// A tenant-scoped API credential for automated data entry from external
// enterprise systems (CRM, ERP, legacy timesheets). Only the SHA-256 hash
// of the key is stored; the plaintext (prefix + secret) is shown once at
// creation. Validation: src/lib/ops/api-keys.ts. Every key belongs to
// exactly one tenant — a request authenticated with it can only ever write
// into that tenant's data.
model ApiKey {
  id             String    @id @default(cuid())
  organizationId String // the tenant this key is scoped to
  name           String // human label, e.g. "Workday timesheet sync"
  // First ~10 chars of the plaintext key (e.g. "a2r_live_7f3k") — safe to
  // display so an operator can identify a key without revealing the secret.
  keyPrefix      String
  hashedKey      String    @unique // sha256(plaintext)
  createdByEmail String
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_keys")
}

// One raw timesheet record ingested via the API Bridge. Also rolled into
// the matching WeeklyAssignmentSlot.actualHours so it flows straight into
// the EAC / burn-curve / capacity engine.
model TimesheetEntry {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  resourceId     String
  hours          Float
  workDate       DateTime // the day the work was performed
  source         String   @default("api") // ingest channel
  apiKeyId       String? // the key that ingested it, when via the bridge
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade)
  resource     Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([organizationId, workDate])
  @@index([projectId, workDate])
  @@map("timesheet_entries")
}

// ---- Resource & Capacity Cockpit ----
// A corporate non-working day. Removed from the Available-Hours denominator
// for every resource in the period (individual PTO is not — see
// src/lib/capacity-engine.ts).
model OrganizationHoliday {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  date           DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@index([organizationId])
  @@map("organization_holidays")
}

// The target utilisation and billable-head classification for a job family.
// `isBillableHead` = false excludes the role from the blended-utilisation
// denominator entirely (Directors, PMO Coordinators).
model RoleUtilizationPolicy {
  id             String   @id @default(cuid())
  organizationId String
  roleName       String // "Solution Architect", "Delivery Staff", "People Manager", "Director", "PMO Coordinator"
  targetUtilPct  Float // 0.72, 0.79, 0.10, 0.00
  isBillableHead Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resources    Resource[]

  @@unique([organizationId, roleName])
  @@index([organizationId])
  @@map("role_utilization_policies")
}

// =========================================================
// MODULE 1 — DEAL CRAFTING & SIZING  (+ project spine)
// =========================================================

enum CommercialModel {
  FF // fixed fee
  TM // time & materials
}

enum GovProfile {
  STANDARD
  MARQUEE
}

enum EstimationMode {
  MATRIX
  DIRECT
}

enum HierarchyLevel {
  STANDALONE
  PARENT
  CHILD
}

model Project {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  client         String?
  externalId     String?

  commercialModel CommercialModel @default(FF)
  methodology     Methodology     @default(WATERFALL)
  govProfile      GovProfile      @default(STANDARD)
  estimationMode  EstimationMode  @default(MATRIX)
  contingencyPct  Float           @default(12)

  practiceDirectorId String?
  deliveryManagerId  String?
  projectManagerId   String?
  // WP4 — the project's home practice for PRACTICE_DIRECTOR portfolio
  // scoping. Independent of practiceDirectorId: a PD can see every
  // project in their practice, not only the ones they're personally
  // assigned to lead. Nullable/unset means this project only shows up for
  // its assigned PD (if any), not for the whole practice.
  practiceId String?

  hierarchyLevel HierarchyLevel @default(STANDALONE)
  parentId       String?
  waveTag        String?

  locked          Boolean   @default(false)
  lockedAt        DateTime?
  baselineSnapshot Json?

  // Direct Baseline Intake (used when estimationMode = DIRECT)
  directIntakeSoldHours         Float @default(0)
  directIntakeTargetRevenue     Float @default(0)
  directIntakeBlendedMarginPct  Float @default(0)

  // Status narrative (steering-deck notes)
  narrativeAccomplishments String? @db.Text
  narrativeBlockers        String? @db.Text
  narrativePriorities      String? @db.Text

  // ---- Capacity & Concurrency schema foundation ----
  // Denormalized EVM-style rollups + a five-lens health vector, kept on the
  // row so portfolio/telemetry surfaces can read them without re-running
  // the calc engine. The live engine (src/lib/calculations) remains the
  // source of truth; these are its last-published snapshot.
  bac                Float   @default(0) // Budget at Completion
  actualsCost        Float   @default(0)
  unscheduledBacklog Float   @default(0) // USB — sold-but-unscheduled value
  vac                Float   @default(0) // Variance at Completion (bac - EAC)
  isRetainer         Boolean @default(false)
  // Denormalized hierarchy flags — mirror hierarchyLevel/parentId, surfaced
  // as plain columns for the capacity views' simpler queries.
  isChild            Boolean @default(false)
  parentProjectId    String?
  healthCost         String  @default("Green")
  healthSched        String  @default("Green")
  healthScope        String  @default("Green")
  healthQual         String  @default("Green")
  healthRes          String  @default("Green")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  practiceDirector Resource? @relation("ProjectPD", fields: [practiceDirectorId], references: [id], onDelete: SetNull)
  deliveryManager  Resource? @relation("ProjectDM", fields: [deliveryManagerId], references: [id], onDelete: SetNull)
  projectManager   Resource? @relation("ProjectPM", fields: [projectManagerId], references: [id], onDelete: SetNull)
  practice         Practice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)

  parent   Project?  @relation("ProjectHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Project[] @relation("ProjectHierarchy")

  scopeItems     ScopeItem[]
  effortCells    EffortCell[]
  auditEntries   AuditEntry[]
  raidEntries    RaidEntry[]
  financials     FinancialActual[]
  schedulePhases SchedulePhase[]
  activity       ActivityLogEntry[]
  // WP4 — PROJECT_MANAGER portfolio scoping's "or explicit contributor"
  // clause: resources named on the project without being its PD/DM/PM of
  // record (e.g. a second PM covering for someone on leave).
  contributors   ProjectContributor[]
  // WP6 — this project's slice of the tenant's immutable Audit Trail.
  auditLogs      AuditLog[]
  // WP7 — this project's SteerCo Decision & Action Tracker rows.
  steerCoDecisions SteerCoDecision[]
  // Capacity foundation — weekly forecast/actual assignment slots.
  weeklySlots      WeeklyAssignmentSlot[]
  timesheetEntries TimesheetEntry[]

  // P0-3 — composite-FK target. Lets every project-scoped child model carry
  // a FOREIGN KEY (organizationId, projectId) → projects(organizationId, id),
  // so the database physically rejects a child row whose tenant disagrees
  // with its project's tenant. (id is already unique; this names the pair.)
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([parentId])
  @@index([practiceId])
  @@map("projects")
}

// A resource explicitly added to a project without being its
// practiceDirectorId/deliveryManagerId/projectManagerId "of record" — see
// getScopedProjectsForUser's PROJECT_MANAGER branch in
// src/lib/db/scoped-portfolio.ts.
model ProjectContributor {
  id         String   @id @default(cuid())
  projectId  String
  // P1 — composite tenant key. Denormalized from Project.organizationId so
  // every row is tied to its tenant by its own FK (not just transitively
  // through `project`), giving the org-scope extension a direct scalar
  // filter and DB-level RLS a same-table policy target. Backfilled +
  // NOT NULL in migration 00000000000012; auto-injected on create by
  // src/lib/db/org-scope.ts.
  organizationId String
  resourceId String
  createdAt  DateTime @default(now())

  project      Project      @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resource     Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([projectId, resourceId])
  @@index([resourceId])
  @@index([organizationId])
  @@map("project_contributors")
}

enum ScopeComplexity {
  LOW
  MEDIUM
  HIGH
}

// One row of the Universal Scope & Taxonomy Matrix.
model ScopeItem {
  id         String          @id @default(cuid())
  projectId  String
  // P1 — composite tenant key (see ProjectContributor.organizationId).
  organizationId String
  key        String // workstream key, e.g. "arch"; free-form for custom rows
  name       String
  included   Boolean         @default(true)
  complexity ScopeComplexity @default(MEDIUM)
  notes      String?         @db.Text
  custom     Boolean         @default(false)
  sortOrder  Int             @default(0)

  project      Project      @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([organizationId])
  @@map("scope_items")
}

// One cell of the Phase-Effort Matrix: hours for (phase, role) on a project.
model EffortCell {
  id        String @id @default(cuid())
  projectId String
  // P1 — composite tenant key (see ProjectContributor.organizationId).
  organizationId String
  phaseKey  String // initiate | design | build | test | deploy | sustain
  roleId    String
  hours     Float  @default(0)

  project      Project      @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         DeliveryRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([projectId, phaseKey, roleId])
  @@index([projectId])
  @@index([organizationId])
  @@map("effort_cells")
}

// =========================================================
// MODULE 2 — CONTROL AUDIT INTAKE
// =========================================================

enum AuditStatus {
  YES
  PARTIAL
  NO
  NA
}

model AuditEntry {
  id         String      @id @default(cuid())
  projectId  String
  // P1 — composite tenant key (see ProjectContributor.organizationId).
  organizationId String
  controlKey String // CTRL_01..CTRL_10
  status     AuditStatus @default(NO)
  owner      String?
  repoLink   String? // evidence URL
  // WP5 — free-text verification notes, distinct from the evidence link
  // itself (e.g. "confirmed with client counsel on 3/1, awaiting a signed
  // copy"). updatedAt (below) already doubles as the "verified at"
  // timestamp the WP5 spec asks for — it's touched on every save.
  notes      String?     @db.Text
  updatedAt  DateTime    @updatedAt

  project      Project      @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([projectId, controlKey])
  @@index([projectId])
  @@index([organizationId])
  @@map("audit_entries")
}

// =========================================================
// MODULE 3 — RAID COCKPIT
// =========================================================

enum RaidType {
  RISK
  ASSUMPTION
  ISSUE
  DEPENDENCY
}

enum RaidSeverity {
  CRITICAL
  HIGH
  MED
  LOW
}

// RTM C3 — the Risk Matrix heatmap's Likelihood axis. `severity` above is
// the Impact axis (unchanged — it already drives badges/notifications
// everywhere), so a RISK-type entry's cell on the 4x4 grid is
// (severity, likelihood). Ordered least→most likely.
enum RaidLikelihood {
  RARE
  POSSIBLE
  LIKELY
  ALMOST_CERTAIN
}

enum RaidStatus {
  OPEN
  INPROGRESS
  CLOSED
}

model RaidEntry {
  id          String       @id @default(cuid())
  projectId   String
  // P1 — composite tenant key (see ProjectContributor.organizationId).
  organizationId String
  type        RaidType
  // WP5 — short label the RAID Cockpit Board's Quick-Add drawer and table
  // display as the item's name, distinct from the longer free-text
  // description below it. Nullable/back-filled from description's first
  // line for rows created before WP5 (see the RaidBoard.tsx display
  // fallback) rather than a required migration default.
  title       String?
  description String       @db.Text
  // WP5 — RAID-methodology fields the Quick-Add drawer asks for
  // separately from the free-text description: what happens if this
  // isn't addressed, and what the plan to address it is.
  impact         String?      @db.Text
  mitigationPlan String?      @db.Text
  severity    RaidSeverity @default(MED)
  // RTM C3 — Risk Matrix heatmap Likelihood axis (Impact axis = severity).
  likelihood  RaidLikelihood @default(POSSIBLE)
  ownerId     String?
  targetDate  DateTime?
  status      RaidStatus   @default(OPEN)
  escalate    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project      Project      @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        Resource?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([organizationId])
  @@map("raid_entries")
}

// =========================================================
// MODULE 4 — FINANCIAL REALIZATION (EAC ENGINE)
// =========================================================

// Actuals/forecast/open-demand row, keyed by role (matrix mode) or the
// synthetic '_direct' roleKey when estimationMode = DIRECT — matches
// src/lib/calculations/financials.ts#computeEacSummary's own convention
// exactly, so calc-adapters.ts never has to translate between the two.
// roleId is nullable to support the '_direct' row, which has no
// rate-card role.
model FinancialActual {
  id             String  @id @default(cuid())
  projectId      String
  // P1 — composite tenant key (see ProjectContributor.organizationId).
  organizationId String
  roleKey        String // DeliveryRole.id, or "_direct" for direct-mode projects
  roleId         String?
  hours          Float   @default(0)
  cost           Float   @default(0)
  forecastHours  Float?
  openRRHours    Float?

  project      Project       @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         DeliveryRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([projectId, roleKey])
  @@index([projectId])
  @@index([organizationId])
  @@map("financial_actuals")
}

// =========================================================
// MODULE 5 — MILESTONE SCHEDULE & BURNDOWN
// =========================================================

enum ScheduleStatus {
  NOTSTARTED
  INPROGRESS
  COMPLETE
  DELAYED
}

model SchedulePhase {
  id            String         @id @default(cuid())
  projectId     String
  // P1 — composite tenant key (see ProjectContributor.organizationId).
  organizationId String
  phaseKey      String // initiate | design | build | test | deploy | sustain
  plannedStart  DateTime?
  plannedEnd    DateTime?
  actualStart   DateTime?
  actualEnd     DateTime?
  pctComplete   Float          @default(0)
  status        ScheduleStatus @default(NOTSTARTED)

  project      Project      @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([projectId, phaseKey])
  @@index([projectId])
  @@index([organizationId])
  @@map("schedule_phases")
}

// =========================================================
// WP7 — SELF-SERVICE BATCH IMPORT ENGINE (weekly BAU client uploads)
// =========================================================
//
// Distinct from src/lib/ingestion/csv-parsers.ts's per-project dry-run/
// commit pair (Effort Matrix, RAID, Financial Actuals — one project, one
// file, one sitting): this is the tenant-wide weekly batch a client
// self-uploads across many projects and resources at once, where rows can
// legitimately need to sit quarantined for a correction pass rather than
// commit-or-discard in one round trip. A DataImportBatch is the staged
// file; each DataImportRow is one row of it, holding the raw cell values
// so a user can correct them in place without re-uploading, plus this
// row's own last-validated status/errors. Nothing here writes to the real
// delivery tables (WeeklyAssignmentSlot / SchedulePhase) until
// commitImportBatch — see src/server/actions/data-import.ts.

enum BatchImportDataType {
  WEEKLY_ACTUALS
  MILESTONE_PROGRESS
  // Forward-looking cost-to-complete / revised EAC inputs — commits into
  // FinancialActual.forecastHours / openRRHours (matrix-mode projects
  // only; see src/lib/ingestion/batch-schemas.ts for why Direct-mode
  // isn't supported in the tenant-wide batch importer yet).
  FORECAST_EAC
  // Weekly narrative status highlights (-> ActivityLogEntry) and/or a new
  // RAID item (-> RaidEntry) per row, at least one of the two required.
  STATUS_RAID
}

enum BatchImportStatus {
  STAGED
  COMMITTED
  DISCARDED
}

enum BatchImportRowStatus {
  VALID
  ERROR
  // A row that started as ERROR and was hand-corrected in the quarantine
  // grid, then re-validated clean. Kept distinct from VALID (rather than
  // just flipping the status back) so the batch summary can still show
  // "N corrected" — an at-a-glance signal of how messy the source file was.
  CORRECTED
}

model DataImportBatch {
  id             String              @id @default(cuid())
  organizationId String
  dataType       BatchImportDataType
  fileName       String
  status         BatchImportStatus   @default(STAGED)

  // Denormalized counts, kept in sync by data-import.ts on every row
  // mutation — cheap enough to recompute from `rows` every time, but
  // storing them means the batch list page never has to load every row.
  totalRows Int
  validRows Int
  errorRows Int

  uploadedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  committedAt  DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  rows         DataImportRow[]

  // P0-3 — composite-FK target for DataImportRow (organizationId, batchId).
  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@map("data_import_batches")
}

model DataImportRow {
  id       String @id @default(cuid())
  batchId  String
  // P1 — composite tenant key. Denormalized from DataImportBatch.organizationId
  // (see ProjectContributor.organizationId). Backfilled via `batch` in
  // migration 00000000000012; auto-injected on create by src/lib/db/org-scope.ts.
  organizationId String
  rowIndex Int // 1-based, counting only data rows (no header)

  // The row's cell values exactly as uploaded (or as last hand-corrected
  // in the quarantine grid) — column-header keyed, all strings, same
  // shape csv-parsers.ts's ParsedCsvRow.raw uses. This is what makes
  // inline correction possible without re-uploading: the file's own text
  // never has to leave the DB once staged.
  raw Json

  status BatchImportRowStatus @default(ERROR)
  // BatchRowIssue[] from src/lib/ingestion/batch-schemas.ts — {field, message}.
  // Empty array for a VALID row.
  errors Json

  updatedAt DateTime @updatedAt

  batch        DataImportBatch @relation(fields: [organizationId, batchId], references: [organizationId, id], onDelete: Cascade)
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([organizationId])
  @@map("data_import_rows")
}

// =========================================================
// CUSTOM KPI DEFINITION ENGINE
// =========================================================
//
// An admin-defined metric card, bound to one of the four real data
// domains this app already computes (financials, schedule, RAID,
// capacity — see src/lib/kpi-engine.ts's KPI_METRICS registry for the
// exact metric catalog) and to the RbacPersona(s)
// (src/lib/governance/rbacMatrix.ts) it should render for. This is a
// curated metric *picker*, not a formula language: `metricKey` selects a
// pre-computed value from the org's real calculation engines, and
// `formulaType` only decides which direction counts as "good" when
// comparing that value to the two thresholds below — there is nowhere to
// inject arbitrary logic.

enum KpiDataSource {
  FINANCIALS
  SCHEDULE
  RAID
  CAPACITY
}

// DIRECT: at/above `targetValue` is on-track (e.g. blended margin).
// INVERSE: at/below `targetValue` is on-track (e.g. a count of overloaded
// resources, where lower is always better).
enum KpiFormulaType {
  DIRECT
  INVERSE
}

model CustomKpi {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  dataSource     KpiDataSource
  // One of src/lib/kpi-engine.ts's KpiMetricKey values for this
  // dataSource — free-text column (same convention as
  // ControlLabel.controlKey) so the metric catalog can grow without a
  // migration.
  metricKey      String
  formulaType    KpiFormulaType @default(DIRECT)
  // "On track" boundary — see KpiFormulaType above for direction.
  targetValue    Float
  // Beyond `targetValue` but at/within `warningValue` reads "at risk";
  // beyond `warningValue` reads "critical". Must sit further from
  // on-track than targetValue in the formulaType's direction — enforced
  // in src/lib/kpi-engine.ts's validateKpiDefinition, not by the DB.
  warningValue   Float
  // RbacPersona values this card renders for (e.g. ["EXECUTIVE_BOARD"]) —
  // free-text array, same convention as GovernanceConfig.hiddenModules.
  targetPersonas String[]       @default([])
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("custom_kpis")
}

// =========================================================
// ACTIVITY LOG (PS Control Tower "Recent Activity")
// =========================================================

model ActivityLogEntry {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  userId         String?
  text           String
  tab            String   @default("home")
  createdAt      DateTime @default(now())

  // Restrict, not Cascade: an Organization row cannot be hard-deleted
  // while its governance history still exists (audit finding CMP-1). The
  // Purge Protocol is a soft delete (Organization.purgedAt) and never
  // removes the org row, so this only blocks an accidental/raw DELETE.
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("activity_log_entries")
}

// =========================================================
// WP6 — IMMUTABLE AUDIT TRAIL (GOVERNANCE INTEGRITY)
// =========================================================

// Distinct from ActivityLogEntry above: that's the PS Control Tower's
// human-readable "Recent Activity" feed (freeform text, every module
// touches it, not meant to be queried or filtered structurally). AuditLog
// is the governance-grade record — structured (action/entityType/entityId
// plus a full previous/new state snapshot as JSON), written only by
// src/lib/audit/logger.ts, and only for the specific mutation families the
// WP6 spec calls out as "critical state changes": baseline lock/unlock,
// EAC actual/forecast updates, RAID SteerCo escalation toggles, audit
// control status changes, plus this WP's own two new bulk-mutation
// surfaces (CSV import commits, workspace snapshot restores). No update or
// delete path is ever exposed for this model anywhere in the app — rows
// are append-only, which is what "immutable" means here in practice (the
// schema itself doesn't enforce it; there's simply no code path that
// mutates or removes a row once logAuditEvent has written it).
//
// The one exception is the data-retention sweep
// (src/server/services/data-retention.ts, CMP-2): it DELETES whole rows
// older than RETENTION_AUDIT_LOG_DAYS (default ~7 years) and never edits
// them. The tamper-EVIDENT hash-chained record is ImmutableAuditLedger —
// the retention sweep never touches that one.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  userId         String?
  // Free-text, not an enum — same convention as ActivityLogEntry.tab —
  // since this WP's action vocabulary (see logger.ts's AuditAction) will
  // keep growing and a free-text column avoids a migration per addition.
  // e.g. BASELINE_LOCKED, BASELINE_UNLOCKED, EAC_ACTUAL_UPDATED,
  // RAID_ESCALATED, RAID_UNESCALATED, AUDIT_SCORE_CHANGED,
  // CSV_IMPORT_COMMITTED, WORKSPACE_RESTORED.
  action         String
  // e.g. PROJECT, FINANCIAL_ACTUAL, RAID_ENTRY, AUDIT_ENTRY, INGESTION, WORKSPACE
  entityType     String
  // The specific row touched (RaidEntry.id, AuditEntry.id, …), when the
  // action is about one row rather than a bulk operation.
  entityId       String?
  previousState  Json?
  newState       Json?
  createdAt      DateTime @default(now())

  // Restrict, not Cascade — the immutable audit trail must outlive any
  // raw Organization DELETE (audit finding CMP-1). See ActivityLogEntry.
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
  @@map("audit_logs")
}

// SOC 2 Compliance Ledger — a tamper-EVIDENT, hash-chained record of the
// highest-consequence governance actions (baseline / stage-gate overrides,
// security-config changes, role-policy edits, tenant lifecycle). Each row
// carries the SHA-256 hash of its own canonical payload chained onto the
// previous row's `currentHash`, so any after-the-fact edit or deletion
// breaks the chain and `verifyLedgerIntegrity` flags it. Append-only:
// src/lib/audit-ledger.ts#recordLedgerEvent is the only writer, and no
// update/delete path is exposed anywhere.
model ImmutableAuditLedger {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String // User ID who performed the action
  actionType     String // e.g. "BASELINE_OVERRIDE", "SECURITY_CONFIG_CHANGE", "STAGE_GATE_OVERRIDE"
  targetResource String // e.g. "Project:123", "RolePolicy:456"
  previousHash   String? // the prior row's currentHash — null only for the genesis row
  currentHash    String // SHA-256 over the canonical record + previousHash
  metadata       Json? // structured payload of change details
  createdAt      DateTime @default(now())

  // Restrict, not Cascade — a hard Organization DELETE must never be able
  // to wipe the tamper-evident SOC 2 ledger (audit finding CMP-1). An
  // operator has to archive/export the chain out-of-band first. The Purge
  // Protocol only soft-deletes (Organization.purgedAt), so this is a
  // backstop against accidental or raw deletes, not normal offboarding.
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // REL-3 — each row in a tenant's chain links to exactly one predecessor,
  // so no two rows may share a previousHash. Combined with the per-tenant
  // advisory lock in recordLedgerEvent, this makes a forked chain
  // impossible even under concurrent appends. (NULL previousHash — the
  // genesis row — is exempt: Postgres treats NULLs as distinct, and the
  // advisory lock already serializes the first append.)
  @@unique([organizationId, previousHash])
  @@index([organizationId, createdAt])
  @@map("immutable_audit_ledger")
}

// =========================================================
// WP7 — EXECUTIVE REPORTING HUB & STEERCO DECISION TRACKER
// =========================================================

enum SteerCoDecisionStatus {
  OPEN
  RESOLVED
}

// One row of a project's SteerCo Decision & Action Tracker — a decision
// the steering committee needs to make (or has made), who owns getting it
// resolved, and by when. Deliberately its own model rather than a repurposed
// RaidEntry: a RAID item is a risk/issue/assumption/dependency to *manage*,
// while a SteerCo decision is a specific ask *of the steering committee
// itself* ("approve the change order," "confirm the go-live date") — the
// SteerCo Status Deck's RAID section and Decision Tracker section are
// deliberately two different lists, not one relabeled.
model SteerCoDecision {
  id                   String                @id @default(cuid())
  projectId            String
  // P1 — composite tenant key (see ProjectContributor.organizationId).
  organizationId       String
  decisionRequired     String                @db.Text
  decisionOwnerId      String?
  resolutionTargetDate DateTime?
  status               SteerCoDecisionStatus @default(OPEN)
  // Free-text note on how/when it was actually resolved — distinct from
  // decisionRequired (the ask) rather than overwriting it, so the tracker
  // keeps a legible "asked X, resolved by doing Y" record.
  resolutionNotes      String?               @db.Text
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  project      Project      @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        Resource?    @relation(fields: [decisionOwnerId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([organizationId])
  @@map("steerco_decisions")
}
